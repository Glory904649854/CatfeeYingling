<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 采集其他应用播放的音频：Android 10+，必须持有 RECORD_AUDIO -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 后台持续采集需要前台服务；Android 14+ 必须声明 microphone 类型权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 悬浮字幕窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 可选的云端 LLM 翻译 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 播放采集本身不依赖麦克风硬件 -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Android 11+ 包可见性：只申请能看到桌面启动器的应用列表，够用且合规 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.YingLing"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.YingLing"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.RecognitionService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection" />
    </application>

</manifest>
